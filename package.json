{
  "name": "acillp-backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "dev:watch": "nodemon src/server.js",
    "indexes:loan": "node src/scripts/ensureLoanIndexes.js",
    "indexes:customer": "node src/scripts/ensureCustomerIndexes.js",
    "indexes:vehicle": "node src/scripts/ensureVehicleIndexes.js",
    "indexes:vehicle-record": "node src/scripts/ensureVehicleRecordIndexes.js",
    "indexes:used-car-leads": "node src/scripts/ensureUsedCarLeadIndexes.js",
    "indexes:insurance": "node src/scripts/ensureInsuranceIndexes.js",
    "indexes:ops": "node src/scripts/ensureOperationsIndexes.js",
    "indexes:ai-agent": "node src/scripts/ensureAiAgentIndexes.js",
    "test:ai-agent": "npm run test:aci:smoke",
    "backfill:latest-business": "node src/scripts/backfillLatestBusinessDate.js",
    "banks:import": "node src/scripts/importBankDirectoryFromFile.js",
    "showrooms:import": "node src/scripts/importCardekhoShowrooms.js",
    "data:import": "node src/seeder.js",
    "vehicles:import": "node src/scripts/importVehicles.js",
    "vehicles:clear": "node src/scripts/clearVehicles.js",
    "vehicles:normalize-pricing": "node src/scripts/normalizeVehiclePricing.js",
    "vehicles:normalize-dataset": "node src/scripts/normalizeVehicleDataset.js",
    "cleanup:legacy-do-payments": "node src/scripts/cleanupLegacyDoPayments.js",
    "do:rebuild": "node src/scripts/rebuildDeliveryOrdersFromLoans.js",
    "payments:rebuild": "node src/scripts/rebuildPaymentsFromDOs.js",
    "fix:hypothecation-bank": "node src/scripts/fixHypothecationFromDisbursedBank.js",
    "fix:payment-loan-dates": "node src/scripts/fixPaymentLoanEntryDatesFromDisbursement.js",
    "audit:vehicle-master": "node src/scripts/auditVehicleMasterRecords.js",
    "backfill:vehicle-master-missing": "node src/scripts/backfillMissingVehicleMasterRecords.js",
    "backfill:disbursed-status": "node src/scripts/backfillDisbursedStatusesFromDates.js --apply",
    "dedupe:loan-ids": "node src/scripts/dedupeLoanIds.js",
    "test:aci:v2": "node src/scripts/testAiAssist.v2.js",
    "test:aci:executor": "node src/scripts/testAiExecutor.js",
    "test:aci:planner": "node src/scripts/testAiPlanner.js",
    "test:aci:subset": "node src/scripts/testAciPriceColorFeatureSubset.js",
    "test:aci:planner:full": "node src/scripts/testAiPlanner.fullRegression.js",
    "test:aci:smoke": "npm run test:aci:executor && npm run test:aci:v2",
    "test:aci:full": "npm run test:aci:planner && npm run test:aci:subset && npm run test:aci:v2",
    "test:aci:contract": "node src/scripts/testAciContractFoundation.js",
    "test:aci:foundation": "npm run test:aci:smoke && npm run test:aci:contract"
  },
  "dependencies": {
    "@ai-sdk/google": "^3.0.67",
    "@aws-sdk/client-s3": "^3.840.0",
    "ai": "^6.0.175",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^17.3.1",
    "express": "^5.2.1",
    "express-async-handler": "^1.2.0",
    "express-validator": "^7.3.1",
    "firebase-admin": "^13.7.0",
    "helmet": "^8.1.0",
    "html-pdf": "^3.0.1",
    "jsonwebtoken": "^9.0.3",
    "mongodb": "^6.21.0",
    "mongoose": "^9.2.1",
    "morgan": "^1.10.1",
    "multer": "^2.0.2",
    "puppeteer": "^24.9.0",
    "xlsx": "^0.18.5",
    "zod": "^4.4.3"
